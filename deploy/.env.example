# Local HTTP example. For production use an HTTPS public URL and a real domain.
COMPOSE_PROJECT_NAME=tack
TACK_GHCR_OWNER=today-ddr
TACK_IMAGE_TAG=dev
TACK_UPDATER_TAG=dev
TACK_SITE_ADDRESS=:80
TACK_PUBLIC_URL=http://localhost
TACK_ADDR=:8080
TACK_DATA_DIR=/data
TACK_ADMIN_USERNAME=admin
TACK_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
TACK_SESSION_SECRET=CHANGE_ME_BASE64_32_BYTE_SECRET
TACK_GITHUB_REPO=Today-ddr/tackflow
TACK_GITHUB_TOKEN=
TACK_WEBHOOK_ALLOW_PRIVATE=false
TACK_UPDATER_URL=http://updater:8081
TACK_UPDATER_TOKEN=CHANGE_ME_UPDATER_TOKEN
TACK_COMPOSE_FILE=/compose/docker-compose.yml
TACK_ENV_FILE=/compose/.env
TACK_SERVICE=app
TACK_UID=501
TACK_GID=20
